{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 20,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "host-debug",
      "displayName": "Rabbit host debug",
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/build/host-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "RABBIT_BUILD_HOST": "ON"
      }
    },
    {
      "name": "host-sanitize",
      "displayName": "Rabbit host sanitizers",
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/build/host-sanitize",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "RABBIT_BUILD_HOST": "ON",
        "CMAKE_CXX_FLAGS": "-fsanitize=address,undefined -fno-omit-frame-pointer",
        "CMAKE_EXE_LINKER_FLAGS": "-fsanitize=address,undefined"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "host-debug",
      "configurePreset": "host-debug"
    },
    {
      "name": "host-sanitize",
      "configurePreset": "host-sanitize"
    }
  ],
  "testPresets": [
    {
      "name": "host-debug",
      "configurePreset": "host-debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "host-sanitize",
      "configurePreset": "host-sanitize",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
